# --- required -------------------------------------------------------------
OPENAI_API_KEY=sk-...
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+15550000000
# Public HTTPS URL that reaches this server (ngrok / cloudflared / your domain)
PUBLIC_BASE_URL=https://your-tunnel.example.com

# --- persona ---------------------------------------------------------------
AGENT_NAME=Robin
OWNER_NAME=Sam
# Numbers that get owner mode (comma-separated, E.164)
OWNER_NUMBERS=+15550001111
# Require carrier-verified caller ID (STIR/SHAKEN attestation A) for owner mode
OWNER_REQUIRE_ATTESTATION=false
TIMEZONE=America/New_York

# --- model -----------------------------------------------------------------
REALTIME_MODEL=gpt-realtime-2.1-mini
REALTIME_VOICE=marin
TRANSCRIPTION_MODEL=whisper-1

# --- optional --------------------------------------------------------------
# Enables POST /calls (outbound missions); also sent to AGENT_WEBHOOK_URL
API_TOKEN=change-me-to-a-long-random-string
# Enables the delegate_task tool (see examples/agent_webhook.py)
AGENT_WEBHOOK_URL=
CONTACTS_FILE=
MAX_CALL_SECONDS=900
SILENCE_NUDGE_SECONDS=30
SILENCE_END_SECONDS=75
MAX_BACKGROUND_JOBS=3
# USD per 1M tokens from the current pricing page, for per-call cost estimates
COST_PER_MTOK=
DATA_DIR=data
LOG_LEVEL=INFO
PORT=8080
